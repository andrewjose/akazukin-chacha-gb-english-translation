# 74-7F: 74 ♡ also used as WAIT blink cursor; 78-7A,7C-7F = window frame tiles
8E=先
8F=生
# 8E/8F: kanji tiles present at $88E0/$88F0 in dialogue scenes (scene-loaded, not part of the font LZ) - guess
FF= 
# --- control codes (argument bytes in brackets) ---
/EF=<END>            # end of string (or return from FB sub-string, nesting count C8D7)
$F0=<SCROLL>          # scroll box text up one line (copies rows), cursor to start of last line
$F1=<SHAKE>           # screen shake (unused in dialogue)
*F2=<CLR>             # clear 4 text rows, cursor home
$F3=<WAIT>            # wait for button, blinking cursor (tile 74) at (18,5); B = replay current message
$F4=<NICK>            # nickname from bank0E $4AB2[CE41*6 + C8D2]
$F5=<NICK2>           # nickname from bank0E $4AB2[CE41*6 + C8D1]
$F6=<ITEM>            # item name bank0E $4BD1[C8D4] (unused in dialogue)
$F7=<ITEM2>           # item name bank0E $4BD1[C8D5]
$F8=<NAMEC8D3>        # enemy/char name bank0E $4C51[C8D3]
$F9=<FACE:%02X>       # 1 arg: portrait. low nibble = face, high nibble = expression; FF = no portrait change
$FA=<FA>              # name from "table" bank0E $5032[C8D6] (unused; $5032 is not a pointer table)
$FB=<CALL:$%04X>      # 2 args LE: call sub-string at addr in the SAME bank (nestable)
$FC=<PAUSE>           # delay 32 frames
$FD=<PASSWORD>        # print 14-char password from CE60 (after encoding via $00:1FF5)
*FE=<NL>              # newline
